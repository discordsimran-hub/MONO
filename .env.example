# Copy this file to `.env` and fill in real values before running the server.
# Do NOT commit the real `.env` file to version control.

# SMTP email account used by Nodemailer
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password-or-app-password

# Optional notification recipient (defaults to EMAIL_USER)
NOTIFY_EMAIL=orders@mono.example

# Twilio (optional) - enable SMS notifications if set
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
TWILIO_TO=+919876543210

# Server port
PORT=3000